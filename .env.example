# Copy to .env and adjust. Never commit .env.
# Shared by db and server (also set in planlos-db/.env and planlos-server/.env)
POSTGRES_PASSWORD=change-me
# Any non-empty value disables the authorized-user check (development only!)
NO_AUTH=
# Web build
URL_BASE=/
VITE_API_BASE_URL=/api/v1
# Host ports (same defaults as the single repos)
DOCS_PORT=8001
WEB_PORT=8002
DB_PORT=8003
SERVER_PORT=8004
